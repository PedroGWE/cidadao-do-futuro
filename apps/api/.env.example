NODE_ENV=development
PORT=3001

# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cidadao_futuro?schema=public"

# JWT — mínimo 32 chars
JWT_SECRET="change-me-in-production-min-32-chars!!"
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET="change-refresh-secret-min-32-chars!!"
JWT_REFRESH_EXPIRES_IN=7d

# Redis
REDIS_URL="redis://localhost:6379"

# CORS
CORS_ORIGINS="http://localhost:3000"

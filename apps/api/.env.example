NODE_ENV=development
PORT=3001

# PostgreSQL
DATABASE_URL="postgresql://semevo:troque-esta-senha@localhost:5432/semevo?schema=public"

# JWT — mínimo 32 chars
JWT_SECRET="change-me-in-production-min-32-chars!!"
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET="change-refresh-secret-min-32-chars!!"
JWT_REFRESH_EXPIRES_IN=7d

# Redis
REDIS_URL="redis://localhost:6379"

# Arquivos persistentes (monte este diretório como volume em produção)
STORAGE_DIR="./uploads"

# CORS
CORS_ORIGINS="http://localhost:3000"
# API pública oficial de Gestão de Parcerias (sem autenticação)
TRANSFEREGOV_API_URL=https://api-publica.transferegov.gestao.gov.br/parcerias
TRANSFEREGOV_TIMEOUT_MS=15000

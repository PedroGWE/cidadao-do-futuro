model BudgetItem {
  id          String   @id @default(cuid())
  category_id String
  description String
  quantity    Decimal  @db.Decimal(12, 4)
  unit        String?
  unit_value  Decimal  @db.Decimal(18, 2)
  total_value Decimal  @db.Decimal(18, 2)
  spent_value Decimal  @default(0) @db.Decimal(18, 2)

  created_at   DateTime        @default(now())

  // Relations
  document Document @relation(fields: [document_id], references: [id])

  @@index([document_id])
  @@index([status])
  @@index([signer_email])
  @@map("document_signatures")
}

model DocumentFolder {
  id          String    @id @default(cuid())
  tenant_id   String
  name        String
  parent_id   String?
  project_id  String?
  description String?
  created_at  DateTime  @default(now())

  // Relations
  tenant   Tenant          @relation(fields: [tenant_id], references: [id])
  parent   DocumentFolder? @relation("FolderHierarchy", fields: [parent_id], references: [id])
  children DocumentFolder[] @relation("FolderHierarchy")
  project  Project?        @relation(fields: [project_id], references: [id])

  @@index([tenant_id])
  @@index([parent_id])
  @@index([project_id])
  @@map("document_folders")
}

// ============================================================
// INSTITUTIONAL DOCUMENTS (repositório de documentos do tenant)

  updated_at  DateTime @updatedAt

  // Relations
  tenant       Tenant       @relation(fields: [tenant_id], references: [id])
  parent       CostCenter?  @relation("CostCenterHierarchy", fields: [parent_id], references: [id])
  children     CostCenter[] @relation("CostCenterHierarchy")
  project      Project?     @relation(fields: [project_id], references: [id])
  transactions Transaction[]

  @@unique([tenant_id, code])
  @@index([tenant_id])
  @@index([parent_id])
  @@index([project_id])
  @@map("cost_centers")
}

model Transaction {
  id               String            @id @default(cuid())
  tenant_id        String
  project_id       String?
  cost_center_id   String?
  type             TransactionType
  status           TransactionStatus @default(PENDENTE)
  description      String
  amount           Decimal           @db.Decimal(18, 2)
  date             DateTime
  due_date         DateTime?
  paid_at          DateTime?
  payment_method   String?
  reference_number String?
  category         String?
  tags             String[]          @default([])
  attachments      Json?             @default("[]")
  created_by       String?
  approved_by      String?
  created_at       DateTime          @default(now())
  updated_at       DateTime          @updatedAt

  // Relations
  tenant             Tenant           @relation(fields: [tenant_id], references: [id])
  project            Project?         @relation(fields: [project_id], references: [id])
  cost_center        CostCenter?      @relation(fields: [cost_center_id], references: [id])
  creator            User?            @relation("TransactionCreator", fields: [created_by], references: [id])
  approver           User?            @relation("TransactionApprover", fields: [approved_by], references: [id])
  payment_orders     PaymentOrder[]
  invoices           Invoice[]
  accountability_items AccountabilityItem[]
  matched_statements AccountStatement[]

  @@index([tenant_id])
  @@index([project_id])
  @@index([cost_center_id])
  @@index([type])
  @@index([status])
  @@index([date])
  @@index([created_by])
  @@map("transactions")
}

model PaymentOrder {
  id                String   @id @default(cuid())
  tenant_id         String
  transaction_id    String?
  supplier_name     String
  supplier_cnpj_cpf String?
  amount            Decimal  @db.Decimal(18, 2)
  due_date          DateTime
  status            String
  bank_data         Json?
  approved_by       String?
  paid_at           DateTime?
  created_at        DateTime @default(now())

  // Relations
  tenant      Tenant       @relation(fields: [tenant_id], references: [id])
  transaction Transaction? @relation(fields: [transaction_id], references: [id])
  approver    User?        @relation(fields: [approved_by], references: [id])

  @@index([tenant_id])
  @@index([transaction_id])
  @@index([status])
  @@index([due_date])
  @@map("payment_orders")
}

model Invoice {
  id              String        @id @default(cuid())
  tenant_id       String
  transaction_id  String?
  number          String?
  supplier_name   String
  supplier_cnpj   String?
  issue_date      DateTime
  amount          Decimal       @db.Decimal(18, 2)
  tax_amount      Decimal?      @db.Decimal(18, 2)
  net_amount      Decimal?      @db.Decimal(18, 2)

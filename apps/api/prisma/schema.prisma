}

model BankReconciliation {
  id               String    @id @default(cuid())
  tenant_id        String
  account_id       String
  period_start     DateTime
  period_end       DateTime
  opening_balance  Decimal   @db.Decimal(18, 2)
  closing_balance  Decimal   @db.Decimal(18, 2)

  race                Race?
  social_vulnerability Json?
  address             Json?
  contact             Json?
  status              BeneficiaryStatus @default(ATIVO)
  enrollment_date     DateTime?
  exit_date           DateTime?
  exit_reason         String?
  created_at          DateTime          @default(now())
  updated_at          DateTime          @updatedAt

  // Relations
  tenant     Tenant               @relation(fields: [tenant_id], references: [id])
  project    Project?             @relation(fields: [project_id], references: [id])
  activities BeneficiaryActivity[]
  enrollments ActivityEnrollment[]
  attendances ActivityAttendance[]

  @@unique([tenant_id, cpf])
  @@index([tenant_id])
  @@index([project_id])
  @@index([status])
  @@index([cpf])
  @@map("beneficiaries")
}

model BeneficiaryActivity {
  id             String   @id @default(cuid())
  beneficiary_id String
  activity_id    String
  attended_at    DateTime
  notes          String?
  created_at     DateTime @default(now())

  // Relations
  beneficiary Beneficiary @relation(fields: [beneficiary_id], references: [id])
  activity    Activity    @relation(fields: [activity_id], references: [id])

  @@index([beneficiary_id])
  @@index([activity_id])
  @@map("beneficiary_activities")
}

// ============================================================
// EVENTS & ACTIVITIES

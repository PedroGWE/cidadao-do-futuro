// ============================================================
// ACCOUNTABILITY / PRESTAÇÃO DE CONTAS
// ============================================================

model AccountabilityReport {
  id                String                     @id @default(cuid())
  tenant_id         String
  project_id        String?
  funding_source_id String?
  title             String
  period_start      DateTime
  period_end        DateTime
  type              AccountabilityReportType
  status            AccountabilityReportStatus @default(RASCUNHO)
  total_received    Decimal?                   @db.Decimal(18, 2)
  total_spent       Decimal?                   @db.Decimal(18, 2)
  balance           Decimal?                   @db.Decimal(18, 2)
  submitted_at      DateTime?
  approved_at       DateTime?
  notes             String?
  created_by        String?
  created_at        DateTime                   @default(now())
  updated_at        DateTime                   @updatedAt

  // Relations
  tenant  Tenant                 @relation(fields: [tenant_id], references: [id])
  project Project?               @relation(fields: [project_id], references: [id])
  creator User?                  @relation("AccountabilityReportCreator", fields: [created_by], references: [id])
  items   AccountabilityItem[]
  glosses AccountabilityGloss[]

  @@index([tenant_id])
  @@index([project_id])
  @@index([type])
  @@index([status])
  @@index([period_start, period_end])
  @@map("accountability_reports")
}

model AccountabilityItem {
  id             String    @id @default(cuid())
  report_id      String
  transaction_id String?
  description    String
  amount         Decimal   @db.Decimal(18, 2)
  category       String?
  document_ids   String[]  @default([])
  notes          String?
  status         String?
  created_at     DateTime  @default(now())

  // Relations
  report      AccountabilityReport @relation(fields: [report_id], references: [id])
  transaction Transaction?         @relation(fields: [transaction_id], references: [id])
  glosses     AccountabilityGloss[]

  @@index([report_id])
  @@index([transaction_id])
  @@map("accountability_items")
}

model AccountabilityGloss {
  id        String      @id @default(cuid())
  report_id String
  item_id   String?
  amount    Decimal     @db.Decimal(18, 2)
  reason    String
  response  String?
  status    GlossStatus @default(PENDENTE)
  created_at DateTime   @default(now())

  // Relations
  report AccountabilityReport @relation(fields: [report_id], references: [id])
  item   AccountabilityItem?  @relation(fields: [item_id], references: [id])

  @@index([report_id])
  @@index([item_id])
  @@index([status])
  @@map("accountability_glosses")
}

// ============================================================

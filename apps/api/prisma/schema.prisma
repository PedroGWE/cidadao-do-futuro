// ============================================================
// Cidadão do Futuro - Prisma Schema
// Brazilian Social Project Management Enterprise SaaS Platform
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum TenantType {
  OSC
  INSTITUTO
  FUNDACAO
  ASSOCIACAO
  EMPRESA
}

enum TenantPlan {
  FREE
  BASIC
  PROFESSIONAL
  ENTERPRISE
}

enum TenantStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  TRIAL
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ProjectType {
  CULTURAL
  ESPORTIVO
  EDUCACIONAL
  ASSISTENCIA_SOCIAL
  SAUDE
  AMBIENTAL
}

enum ProjectStatus {
  RASCUNHO
  CAPTACAO
  APROVADO
  EM_EXECUCAO
  CONCLUIDO
  SUSPENSO
  CANCELADO
}

enum ProjectMemberRole {
  GESTOR
  COORDENADOR
  COLABORADOR
  VOLUNTARIO
}

enum PhaseStatus {
  NAO_INICIADA
  EM_ANDAMENTO
  CONCLUIDA
  SUSPENSA
  CANCELADA
}

enum TaskStatus {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
  BLOQUEADA
}

enum TaskPriority {
  BAIXA
  MEDIA
  ALTA
  URGENTE
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RiskStatus {
  IDENTIFICADO
  EM_MONITORAMENTO
  MITIGADO
  OCORRIDO
  ENCERRADO
}

enum FundingOpportunityType {
  EDITAL
  CONVENIO
  EMENDA
  PATROCINIO
  LEI_INCENTIVO
  DOACAO
}

enum FundingOpportunityStatus {
  ABERTO
  ENCERRADO
  SUSPENSO
  EM_BREVE
}

enum FundingApplicationStatus {
  RASCUNHO
  SUBMETIDO
  EM_ANALISE
  APROVADO
  REPROVADO
  RECURSO
  HOMOLOGADO
}

enum IncentiveLawType {
  ROUANET
  FNC
  PRONAC
  ESTADUAL
  MUNICIPAL
  ESPORTE
  CRIANCA
}

enum ConvenioStatus {
  PROPOSTA
  ASSINADO
  EM_EXECUCAO
  PRESTACAO_CONTAS
  ENCERRADO
  INADIMPLENTE
}

enum EmendaType {
  INDIVIDUAL
  BANCADA
  COMISSAO
}

enum EmendaStatus {
  INDICADA
  EMPENHADA
  PAGA
  CANCELADA
}

enum BudgetStatus {
  ATIVO
  SUSPENSO
  ENCERRADO
  REVISAO
}

enum TransactionType {
  RECEITA
  DESPESA
  TRANSFERENCIA
  DEVOLUCAO
}

enum TransactionStatus {
  PENDENTE
  APROVADO
  PAGO
  CANCELADO
  ESTORNADO
}

enum InvoiceStatus {
  PENDENTE
  VALIDADA
  REJEITADA
}

enum DocumentType {
  CONTRATO
  ESTATUTO
  CERTIDAO
  RELATORIO
  NOTA_FISCAL
  COMPROVANTE
  OFICIO
  ATA
  OUTROS
}

enum DocumentStatus {
  RASCUNHO
  PENDENTE_ASSINATURA
  ASSINADO
  VENCIDO
  ARQUIVADO
}

enum SignatureStatus {
  PENDENTE
  ASSINADO
  REJEITADO
}

enum AccountabilityReportType {
  PARCIAL
  FINAL
  ANUAL
}

enum AccountabilityReportStatus {
  RASCUNHO
  EM_REVISAO
  SUBMETIDO
  EM_ANALISE
  APROVADO
  REPROVADO
  PENDENTE_CORRECAO
}

enum GlossStatus {
  PENDENTE
  ACEITO
  RECURSO
  DEFINITIVO
}

enum IndicatorType {
  QUANTITATIVO
  QUALITATIVO
}

enum MeasurementFrequency {
  DIARIO
  SEMANAL
  MENSAL
  TRIMESTRAL
  ANUAL
}

enum Gender {
  MASCULINO
  FEMININO
  NAO_BINARIO
  PREFIRO_NAO_INFORMAR
  OUTRO
}

enum Race {
  BRANCA
  PRETA
  PARDA
  AMARELA
  INDIGENA
  NAO_DECLARADA
}

enum BeneficiaryStatus {
  ATIVO
  INATIVO
  SUSPENSO
  EGRESSO
}

enum ActivityType {
  OFICINA
  AULA
  EVENTO
  REUNIAO
  VISITA
  CAPACITACAO
  OUTROS
}

enum ActivityStatus {
  AGENDADA
  EM_ANDAMENTO
  REALIZADA
  CANCELADA
}

enum EnrollmentStatus {
  INSCRITO
  CONFIRMADO
  AUSENTE
  PRESENTE
  CANCELADO
}

enum PartnerType {
  EMPRESA
  GOVERNO
  OUTRO_OSC
  PESSOA_FISICA
  INTERNACIONAL
}

enum PartnerStatus {
  PROSPECTO
  ATIVO
  INATIVO
}

enum PartnershipType {
  PATROCINIO
  PARCERIA_TECNICA
  COEXECUCAO
  DOACAO
  VOLUNTARIADO
}

enum PartnershipStatus {
  PROPOSTA
  ATIVO
  ENCERRADO
  CANCELADO
}

enum SponsorTier {
  DIAMANTE
  OURO
  PRATA
  BRONZE
  APOIADOR
}

enum SponsorStatus {
  ATIVO
  INATIVO
  PROSPECTO
}

enum WorkflowStatus {
  PENDENTE
  EM_ANDAMENTO
  APROVADO
  REJEITADO
  CANCELADO
}

enum ApprovalStatus {
  PENDENTE
  APROVADO
  REJEITADO
  DELEGADO
}

enum ComplianceStatus {
  CONFORME
  NAO_CONFORME
  PENDENTE
  NA
}

enum LGPDConsentStatus {
  ATIVO
  REVOGADO
}

enum AIAgentType {
  JURIDICO
  FINANCEIRO
  CAPTACAO
  GESTAO
  COMPLIANCE
}

enum AIAgentStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum AITaskStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  WHATSAPP
  PUSH
}

enum NotificationStatus {
  PENDING
  SENT
  READ
  FAILED
}

enum OrganizationDocumentStatus {
  VALIDO
  VENCIDO
  PENDENTE
  REJEITADO
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

// ============================================================
// TENANT & IDENTITY
// ============================================================

model Tenant {
  id         String       @id @default(cuid())
  slug       String       @unique
  name       String
  type       TenantType
  plan       TenantPlan   @default(FREE)
  status     TenantStatus @default(TRIAL)
  settings   Json         @default("{}")
  logo_url   String?
  cnpj       String?      @unique
  created_at DateTime     @default(now())
  updated_at DateTime     @updatedAt
  deleted_at DateTime?

  // Relations
  users                  User[]
  roles                  Role[]
  organizations          Organization[]
  projects               Project[]
  funding_opportunities  FundingOpportunity[]
  funding_applications   FundingApplication[]
  incentive_laws         IncentiveLaw[]
  convenios              Convenio[]
  emendas                EmendaParlamentar[]
  budgets                Budget[]
  cost_centers           CostCenter[]
  transactions           Transaction[]
  payment_orders         PaymentOrder[]
  invoices               Invoice[]
  bank_reconciliations   BankReconciliation[]
  documents              Document[]
  accountability_reports AccountabilityReport[]
  indicators             Indicator[]
  beneficiaries          Beneficiary[]
  activities             Activity[]
  partners               Partner[]
  partnerships           Partnership[]
  sponsors               Sponsor[]
  workflow_templates     WorkflowTemplate[]
  workflow_instances     WorkflowInstance[]
  legal_requirements     LegalRequirement[]
  compliance_checks      ComplianceCheck[]
  lgpd_consents          LGPDConsent[]
  ai_agents              AIAgent[]
  ai_conversations       AIConversation[]
  ai_tasks               AITask[]
  document_embeddings    DocumentEmbedding[]
  notifications          Notification[]
  notification_templates NotificationTemplate[]
  system_settings        SystemSetting[]
  audit_logs             AuditLog[]
  document_folders       DocumentFolder[]
  user_invites           UserInvite[]
  institutional_doc_categories InstitutionalDocCategory[]
  institutional_documents      InstitutionalDocument[]

  @@index([slug])
  @@index([cnpj])
  @@index([status])
  @@index([deleted_at])
  @@map("tenants")
}

model User {
  id                  String     @id @default(cuid())
  tenant_id           String
  email               String
  password_hash       String
  name                String
  phone               String?
  avatar_url          String?
  status              UserStatus @default(ACTIVE)
  email_verified_at   DateTime?
  last_login_at       DateTime?
  created_at          DateTime   @default(now())
  updated_at          DateTime   @updatedAt
  deleted_at          DateTime?

  // Relations
  tenant                 Tenant               @relation(fields: [tenant_id], references: [id])
  user_roles             UserRole[]           @relation("UserToUserRole")
  granted_roles          UserRole[]           @relation("GrantedByUser")
  refresh_tokens         RefreshToken[]
  managed_projects       Project[]            @relation("ProjectManager")
  created_projects       Project[]            @relation("ProjectCreator")
  project_members        ProjectMember[]
  assigned_tasks         ProjectTask[]
  risk_owners            ProjectRisk[]
  ai_conversations       AIConversation[]
  notifications          Notification[]
  created_documents      Document[]           @relation("DocumentCreator")
  document_versions      DocumentVersion[]
  accountability_reports AccountabilityReport[] @relation("AccountabilityReportCreator")
  workflow_instances     WorkflowInstance[]   @relation("WorkflowStarter")
  workflow_approvals     WorkflowApproval[]
  compliance_checks      ComplianceCheck[]    @relation("ComplianceChecker")
  system_settings        SystemSetting[]
  audit_logs             AuditLog[]
  activity_responsible   Activity[]
  sent_invites           UserInvite[]         @relation("InviteSender")
  indicator_measurements IndicatorMeasurement[] @relation("MeasurementVerifier")
  created_indicators     Indicator[]
  created_transactions   Transaction[]        @relation("TransactionCreator")
  approved_transactions  Transaction[]        @relation("TransactionApprover")
  approved_payment_orders PaymentOrder[]
  validated_invoices     Invoice[]
  institutional_documents InstitutionalDocument[] @relation("InstitutionalDocUploader")

  @@unique([tenant_id, email])
  @@index([tenant_id])
  @@index([email])
  @@index([status])
  @@index([deleted_at])
  @@map("users")
}

model Role {
  id          String   @id @default(cuid())
  tenant_id   String
  name        String
  description String?
  is_system   Boolean  @default(false)
  permissions Json     @default("[]")
  created_at  DateTime @default(now())

  // Relations
  tenant       Tenant       @relation(fields: [tenant_id], references: [id])
  user_roles   UserRole[]
  user_invites UserInvite[]

  @@unique([tenant_id, name])
  @@index([tenant_id])
  @@map("roles")
}

model UserRole {
  user_id    String
  role_id    String
  granted_by String?
  granted_at DateTime  @default(now())
  expires_at DateTime?

  // Relations
  user       User  @relation("UserToUserRole", fields: [user_id], references: [id])
  role       Role  @relation(fields: [role_id], references: [id])
  granted_by_user User? @relation("GrantedByUser", fields: [granted_by], references: [id])

  @@id([user_id, role_id])
  @@index([user_id])
  @@index([role_id])
  @@index([granted_by])
  @@index([expires_at])
  @@map("user_roles")
}

model Permission {
  id          String  @id @default(cuid())
  resource    String
  action      String
  description String?

  @@unique([resource, action])
  @@index([resource])
  @@map("permissions")
}

model RefreshToken {
  id         String    @id @default(cuid())
  user_id    String
  token_hash String    @unique
  expires_at DateTime
  revoked_at DateTime?
  user_agent String?
  ip_address String?
  created_at DateTime  @default(now())

  // Relations
  user User @relation(fields: [user_id], references: [id])

  @@index([user_id])
  @@index([token_hash])
  @@index([expires_at])
  @@map("refresh_tokens")
}

model AuditLog {
  id          String   @id @default(cuid())
  tenant_id   String
  user_id     String?
  action      String
  resource    String
  resource_id String?
  old_value   Json?
  new_value   Json?
  ip_address  String?
  user_agent  String?
  created_at  DateTime @default(now())

  // Relations
  tenant Tenant @relation(fields: [tenant_id], references: [id])
  user   User?  @relation(fields: [user_id], references: [id])

  @@index([tenant_id])
  @@index([user_id])
  @@index([resource, resource_id])
  @@index([action])
  @@index([created_at])
  @@map("audit_logs")
}

// ============================================================
// ORGANIZATIONS
// ============================================================

model Organization {
  id           String    @id @default(cuid())
  tenant_id    String    @unique
  legal_name   String
  trade_name   String?
  cnpj         String?   @unique
  type         TenantType
  founded_at   DateTime?
  mission      String?
  vision       String?
  values       String?
  address      Json?
  social_links Json?     @default("{}")
  bank_accounts Json?    @default("[]")
  certificates Json?     @default("[]")
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  // Relations
  tenant    Tenant                 @relation(fields: [tenant_id], references: [id])
  documents OrganizationDocument[]

  @@index([tenant_id])
  @@index([cnpj])
  @@map("organizations")
}

model OrganizationDocument {
  id          String                     @id @default(cuid())
  org_id      String
  type        String
  name        String
  file_url    String
  issued_at   DateTime?
  expires_at  DateTime?
  status      OrganizationDocumentStatus @default(VALIDO)
  created_at  DateTime                   @default(now())

  // Relations
  organization Organization @relation(fields: [org_id], references: [id])

  @@index([org_id])
  @@index([status])
  @@index([expires_at])
  @@map("organization_documents")
}

// ============================================================
// PROJECTS
// ============================================================

model Project {
  id               String        @id @default(cuid())
  tenant_id        String
  code             String?
  name             String
  description      String?
  type             ProjectType
  status           ProjectStatus @default(RASCUNHO)
  start_date       DateTime?
  end_date         DateTime?
  total_budget     Decimal?      @db.Decimal(18, 2)
  approved_budget  Decimal?      @db.Decimal(18, 2)
  funding_sources  Json?         @default("[]")
  tags             String[]      @default([])
  manager_id       String?
  created_by       String?
  created_at       DateTime      @default(now())
  updated_at       DateTime      @updatedAt
  deleted_at       DateTime?

  // Relations
  tenant                 Tenant                 @relation(fields: [tenant_id], references: [id])
  manager                User?                  @relation("ProjectManager", fields: [manager_id], references: [id])
  creator                User?                  @relation("ProjectCreator", fields: [created_by], references: [id])
  members                ProjectMember[]
  phases                 ProjectPhase[]
  tasks                  ProjectTask[]
  risks                  ProjectRisk[]
  indicators             ProjectIndicator[]
  funding_applications   FundingApplication[]
  convenios              Convenio[]
  emendas                EmendaParlamentar[]
  budgets                Budget[]
  cost_centers           CostCenter[]
  transactions           Transaction[]
  documents              Document[]
  accountability_reports AccountabilityReport[]
  social_indicators      Indicator[]
  beneficiaries          Beneficiary[]
  activities             Activity[]
  partnerships           Partnership[]
  document_folders       DocumentFolder[]
  compliance_checks      ComplianceCheck[]

  @@unique([tenant_id, code])
  @@index([tenant_id])
  @@index([status])
  @@index([type])
  @@index([manager_id])
  @@index([deleted_at])
  @@map("projects")
}

model ProjectMember {
  id         String            @id @default(cuid())
  project_id String
  user_id    String
  role       ProjectMemberRole @default(COLABORADOR)
  start_date DateTime?
  end_date   DateTime?
  created_at DateTime          @default(now())

  // Relations
  project Project @relation(fields: [project_id], references: [id])
  user    User    @relation(fields: [user_id], references: [id])

  @@unique([project_id, user_id])
  @@index([project_id])
  @@index([user_id])
  @@map("project_members")
}

model ProjectPhase {
  id          String      @id @default(cuid())
  project_id  String
  name        String
  description String?
  order       Int
  start_date  DateTime?
  end_date    DateTime?
  status      PhaseStatus @default(NAO_INICIADA)
  created_at  DateTime    @default(now())

  // Relations
  project Project       @relation(fields: [project_id], references: [id])
  tasks   ProjectTask[]

  @@index([project_id])
  @@index([status])
  @@map("project_phases")
}

model ProjectTask {
  id          String       @id @default(cuid())
  project_id  String
  phase_id    String?
  title       String
  description String?
  assigned_to String?
  due_date    DateTime?
  status      TaskStatus   @default(PENDENTE)
  priority    TaskPriority @default(MEDIA)
  attachments Json?        @default("[]")
  created_at  DateTime     @default(now())
  updated_at  DateTime     @updatedAt

  // Relations
  project  Project       @relation(fields: [project_id], references: [id])
  phase    ProjectPhase? @relation(fields: [phase_id], references: [id])
  assignee User?         @relation(fields: [assigned_to], references: [id])

  @@index([project_id])
  @@index([phase_id])
  @@index([assigned_to])
  @@index([status])
  @@index([priority])
  @@index([due_date])
  @@map("project_tasks")
}

model ProjectRisk {
  id          String     @id @default(cuid())
  project_id  String
  title       String
  description String?
  category    String?
  probability RiskLevel
  impact      RiskLevel
  mitigation  String?
  status      RiskStatus @default(IDENTIFICADO)
  owner_id    String?
  created_at  DateTime   @default(now())
  updated_at  DateTime   @updatedAt

  // Relations
  project Project @relation(fields: [project_id], references: [id])
  owner   User?   @relation(fields: [owner_id], references: [id])

  @@index([project_id])
  @@index([owner_id])
  @@index([status])
  @@map("project_risks")
}

model ProjectIndicator {
  id            String    @id @default(cuid())
  project_id    String
  name          String
  description   String?
  unit          String?
  baseline      Decimal?  @db.Decimal(18, 4)
  target        Decimal?  @db.Decimal(18, 4)
  current_value Decimal?  @db.Decimal(18, 4)
  frequency     MeasurementFrequency?
  last_updated  DateTime?
  created_at    DateTime  @default(now())

  // Relations
  project Project @relation(fields: [project_id], references: [id])

  @@index([project_id])
  @@map("project_indicators")
}

// ============================================================
// FUNDRAISING / CAPTAÇÃO
// ============================================================

model FundingOpportunity {
  id            String                   @id @default(cuid())
  tenant_id     String
  title         String
  description   String?
  type          FundingOpportunityType
  source_name   String?
  source_url    String?
  total_amount  Decimal?                 @db.Decimal(18, 2)
  min_amount    Decimal?                 @db.Decimal(18, 2)
  max_amount    Decimal?                 @db.Decimal(18, 2)
  opens_at      DateTime?
  closes_at     DateTime?
  status        FundingOpportunityStatus @default(ABERTO)
  requirements  Json?                    @default("{}")
  areas         String[]                 @default([])
  tags          String[]                 @default([])
  created_at    DateTime                 @default(now())
  updated_at    DateTime                 @updatedAt

  // Relations
  tenant       Tenant               @relation(fields: [tenant_id], references: [id])
  applications FundingApplication[]

  @@index([tenant_id])
  @@index([type])
  @@index([status])
  @@index([closes_at])
  @@map("funding_opportunities")
}

model FundingApplication {
  id              String                   @id @default(cuid())
  tenant_id       String
  project_id      String?
  opportunity_id  String?
  title           String
  status          FundingApplicationStatus @default(RASCUNHO)
  submitted_at    DateTime?
  result_at       DateTime?
  approved_amount Decimal?                 @db.Decimal(18, 2)
  notes           String?
  documents       Json?                    @default("[]")
  created_at      DateTime                 @default(now())
  updated_at      DateTime                 @updatedAt

  // Relations
  tenant      Tenant              @relation(fields: [tenant_id], references: [id])
  project     Project?            @relation(fields: [project_id], references: [id])
  opportunity FundingOpportunity? @relation(fields: [opportunity_id], references: [id])

  @@index([tenant_id])
  @@index([project_id])
  @@index([opportunity_id])
  @@index([status])
  @@map("funding_applications")
}

model IncentiveLaw {
  id                String           @id @default(cuid())
  tenant_id         String
  name              String
  type              IncentiveLawType
  description       String?
  fiscal_benefit_pct Decimal?        @db.Decimal(5, 2)
  max_amount        Decimal?         @db.Decimal(18, 2)
  min_amount        Decimal?         @db.Decimal(18, 2)
  eligible_areas    String[]         @default([])
  requirements      Json?            @default("{}")
  valid_from        DateTime?
  valid_until       DateTime?
  status            String?
  created_at        DateTime         @default(now())

  // Relations
  tenant Tenant @relation(fields: [tenant_id], references: [id])

  @@index([tenant_id])
  @@index([type])
  @@index([status])
  @@map("incentive_laws")
}

model Convenio {
  id                String         @id @default(cuid())
  tenant_id         String
  project_id        String?
  number            String?
  concedente        String
  interveniente     String?
  object            String
  total_value       Decimal        @db.Decimal(18, 2)
  counterpart_value Decimal?       @db.Decimal(18, 2)
  start_date        DateTime?
  end_date          DateTime?
  status            ConvenioStatus @default(PROPOSTA)
  siconv_id         String?
  bank_account      Json?
  created_at        DateTime       @default(now())
  updated_at        DateTime       @updatedAt

  // Relations
  tenant  Tenant   @relation(fields: [tenant_id], references: [id])
  project Project? @relation(fields: [project_id], references: [id])

  @@index([tenant_id])
  @@index([project_id])
  @@index([status])
  @@index([number])
  @@map("convenios")
}

model EmendaParlamentar {
  id                String       @id @default(cuid())
  tenant_id         String
  project_id        String?
  number            String?
  year              Int
  parlamentar_name  String
  parlamentar_party String?
  type              EmendaType
  value             Decimal      @db.Decimal(18, 2)
  status            EmendaStatus @default(INDICADA)
  object            String?
  created_at        DateTime     @default(now())
  updated_at        DateTime     @updatedAt

  // Relations
  tenant  Tenant   @relation(fields: [tenant_id], references: [id])
  project Project? @relation(fields: [project_id], references: [id])

  @@index([tenant_id])
  @@index([project_id])
  @@index([status])
  @@index([year])
  @@map("emendas_parlamentares")
}

// ============================================================
// FINANCIAL MANAGEMENT
// ============================================================

model Budget {
  id                String       @id @default(cuid())
  tenant_id         String
  project_id        String?
  funding_source_id String?
  fiscal_year       Int
  total_amount      Decimal      @db.Decimal(18, 2)
  allocated         Decimal      @default(0) @db.Decimal(18, 2)
  committed         Decimal      @default(0) @db.Decimal(18, 2)
  spent             Decimal      @default(0) @db.Decimal(18, 2)
  balance           Decimal      @db.Decimal(18, 2)
  status            BudgetStatus @default(ATIVO)
  created_at        DateTime     @default(now())
  updated_at        DateTime     @updatedAt

  // Relations
  tenant     Tenant           @relation(fields: [tenant_id], references: [id])
  project    Project?         @relation(fields: [project_id], references: [id])
  categories BudgetCategory[]

  @@index([tenant_id])
  @@index([project_id])
